{
  "mcpServers": {
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "mcp-server-linkedin": {
      "command": "uvx",
      "args": ["mcp-server-linkedin@latest"],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "naukri-mcp": {
      "command": "bash",
      "args": ["tools/run-naukri-mcp.sh"],
      "envFile": ".env.naukri"
    }
  }
}
