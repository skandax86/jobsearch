# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=CareerPilot AI
LOG_LEVEL=INFO

# ── API (FastAPI) ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ── Web (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot_dev

DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_dev@localhost:5433/careerpilot

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO for local dev) ──────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=careerpilot
STORAGE_SECRET_KEY=careerpilot_dev
STORAGE_BUCKET=careerpilot-resumes
STORAGE_REGION=us-east-1

# ── Auth / Sessions ───────────────────────────────────────────
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=careerpilot_session
SESSION_CACHE_ENABLED=true

# ── Web ───────────────────────────────────────────────────────
WEB_APP_URL=http://localhost:3000

# ── Credential encryption (change in production) ──────────────
CREDENTIALS_SECRET=careerpilot-dev-credentials-secret-change-me

# ── LinkedIn OAuth (personal Connect only — not SSO login) ────
# Sign in to CareerPilot with email/password, then Connect LinkedIn
# from the dashboard for your own account.
# Create an app at https://www.linkedin.com/developers/
# Enable "Sign In with LinkedIn using OpenID Connect"
# Auth callback: http://localhost:8000/api/v1/auth/linkedin/callback
# Leave client id/secret empty for mock OAuth, or set real values from
# https://www.linkedin.com/developers/ (Sign In with LinkedIn using OpenID Connect).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile email
# ── Naukri (optional in-app discovery) ────────────────────────
# Prefer .env.naukri (gitignored). Same vars also work here.
# Setup: make naukri-mcp-setup
# Then: cd apps/api && . .venv/bin/activate && pip install -e '.[naukri]' && playwright install chromium
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=
# NAUKRI_DEFAULT_LOCATION=Bengaluru
# NAUKRI_DEFAULT_EXPERIENCE_YEARS=2
# NAUKRI_DEFAULT_SKILLS=Python,SQL
