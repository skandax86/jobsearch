# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=CareerPilot AI
LOG_LEVEL=INFO

# ── API (FastAPI) ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ── Web (Next.js) ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=careerpilot
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=careerpilot_dev

DATABASE_URL=postgresql+asyncpg://careerpilot:careerpilot_dev@localhost:5432/careerpilot

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO for local dev) ──────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=careerpilot
STORAGE_SECRET_KEY=careerpilot_dev
STORAGE_BUCKET=careerpilot-resumes
STORAGE_REGION=us-east-1
