# Naukri MCP — personal credentials (do not commit)
# From: https://github.com/sanjeev-txt/Naukri-MCP
#
# Copy to .env.naukri and fill in real values:
#   cp .env.naukri.example .env.naukri
#
# Numeric fields must be numbers (not blank) — empty strings crash the server.

# --- Login Option 1: Email + Password ---
NAUKRI_EMAIL=
NAUKRI_PASSWORD=

# --- Login Option 2: Phone + OTP (leave EMAIL/PASSWORD blank) ---
# NAUKRI_PHONE=

BASE_RESUME_PATH=
RESUME_OUTPUT_DIR=~/.naukri-mcp/resumes
# HEADLESS=true uses installed Google Chrome (channel=chrome).
# Playwright's bundled Chromium is blocked by Naukri (403). Install Chrome if needed.
HEADLESS=true
REQUEST_DELAY_SECONDS=2
MAX_APPLICATIONS_PER_SESSION=10

# Candidate profile — used for match scoring / form answers
# CTC in LPA (lakhs per annum); experience in years
CANDIDATE_CURRENT_CTC=0
CANDIDATE_EXPECTED_CTC=0
CANDIDATE_NOTICE_DAYS=60
CANDIDATE_EXPERIENCE_YEARS=0
CANDIDATE_LOCATION=
CANDIDATE_WILLING_TO_RELOCATE=true
CANDIDATE_SKILLS=Python,FastAPI,PostgreSQL,SQL,Spark
