{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerpilot.ai/schemas/mcp/tool-result.json",
  "title": "McpToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["SUCCESS", "ERROR", "UNSUPPORTED"]
    },
    "result": { "type": "object" },
    "metadata": { "type": "object" },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"]
    }
  }
}
